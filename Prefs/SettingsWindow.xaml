<Window x:Class="SnapView.Prefs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:SnapView.Prefs"
        xmlns:ed="clr-namespace:SnapView.Editor"
        Title="SnapView 설정"
        Width="640" Height="760"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- BasedOn 을 빼면 앱의 어두운 모양을 덮어써서 이 창만 기본 흰색으로 나온다. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#FF15151A"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,0,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="14,8">
                <Button Style="{StaticResource ToolButton}" Content="기본값으로 되돌리기"
                        HorizontalAlignment="Left" Foreground="{StaticResource FgDim}"
                        Click="OnResetDefaults"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolButton}" Content="설정 폴더 열기" Click="OnOpenFolder"/>
                    <Rectangle Style="{StaticResource ToolSeparator}"/>
                    <Button Style="{StaticResource ToolButton}" Content="취소" Click="OnCancel"/>
                    <Button Style="{StaticResource ToolButton}" Content="저장"
                            Foreground="#FF6FD08C" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
            <StackPanel>

                <!-- ================= 캡처 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="캡처하면"/>
                <CheckBox x:Name="CbSave" Content="파일로 저장"/>
                <CheckBox x:Name="CbClipboard" Content="클립보드에 복사"/>
                <CheckBox x:Name="CbViewer" Content="뷰어 열기"/>
                <CheckBox x:Name="CbEditor" Content="주석 편집기 열기"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="편집기를 켜면 뷰어 대신 편집기가 먼저 뜹니다. 편집을 마치면 위 설정대로 저장·복사됩니다."/>

                <TextBlock Style="{StaticResource Section}" Text="영역 선택"/>
                <CheckBox x:Name="CbAdjust" Content="영역을 놓은 뒤 조절 단계 거치기"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="끄면 마우스를 떼는 즉시 확정됩니다. 켜면 모서리를 잡아 크기를 다시 맞추거나, 편집·복사·저장을 바로 고를 수 있습니다."/>
                <CheckBox x:Name="CbCross" Content="커서를 따라다니는 십자 안내선 보이기"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="화면 끝까지 이어지는 점선이라, 잡고 싶은 대상의 모서리에 선을 맞춰 놓고 드래그하면 딱 떨어집니다."/>
                <CheckBox x:Name="CbWgc" Content="창 캡처에 Graphics Capture 사용"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="켜면 위에 겹친 창이 같이 찍히지 않고, 하드웨어 가속으로 그리는 창도 검게 나오지 않습니다. 안 되는 창은 자동으로 예전 방식으로 넘어갑니다."/>
                <CheckBox x:Name="CbCursor" Content="마우스 커서 포함"/>
                <CheckBox x:Name="CbSound" Content="캡처 소리 내기"/>
                <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="소리 크기" Margin="0,0,8,0"/>
                    <Slider x:Name="SlVolume" Width="150" Minimum="0" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="OnVolumeChanged"/>
                    <TextBlock x:Name="LbVolume" Style="{StaticResource Label}" Margin="8,0,8,0" MinWidth="34"/>
                    <Button Style="{StaticResource ToolButton}" Content="들어보기" Click="OnPreviewSound"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="셔터 소리가 아니라 짧고 부드러운 알림음입니다. 0 으로 두면 소리가 나지 않습니다."/>

                <!-- ================= 저장 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="저장"/>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="폴더"/>
                    <TextBox x:Name="TbFolder" Grid.Column="1"/>
                    <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="찾아보기"
                            Click="OnBrowseFolder"/>
                </Grid>

                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="이름 규칙"/>
                    <TextBox x:Name="TbPattern" Grid.Column="1" IsReadOnly="False"/>
                </Grid>
                <TextBlock x:Name="TbPreview" Style="{StaticResource Note}" Margin="86,2,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="86,2,0,0">
                    <RadioButton x:Name="RbPng" Content="PNG" GroupName="fmt"/>
                    <RadioButton x:Name="RbJpg" Content="JPG" GroupName="fmt"/>
                    <TextBlock Style="{StaticResource Label}" Text="품질" Margin="14,0,6,0"/>
                    <Slider x:Name="SlQuality" Width="130" Minimum="40" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LbQuality" Style="{StaticResource Label}" Margin="8,0,0,0" MinWidth="26"/>
                </StackPanel>

                <!-- ================= 단축키 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="전역 단축키"/>
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                           Text="칸을 클릭한 뒤 원하는 키 조합을 그대로 누르세요. ESC 나 Delete 를 누르면 지워집니다."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="영역 캡처"/>
                    <p:HotKeyBox x:Name="HkRegion" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkRegionNote" Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="전체 화면"/>
                    <p:HotKeyBox x:Name="HkFull" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkFullNote" Grid.Row="1" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="활성 창"/>
                    <p:HotKeyBox x:Name="HkWindow" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkWindowNote" Grid.Row="2" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}"
                               Text="영역 녹화"/>
                    <p:HotKeyBox x:Name="HkRecord" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkRecordNote" Grid.Row="3" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}"
                               Text="전체 화면 녹화"/>
                    <p:HotKeyBox x:Name="HkRecordFull" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkRecordFullNote" Grid.Row="4" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}"
                               Text="활성 창 녹화"/>
                    <p:HotKeyBox x:Name="HkRecordWindow" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
                    <TextBlock x:Name="HkRecordWindowNote" Grid.Row="5" Grid.Column="2"
                               Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Style="{StaticResource Note}"
                           Text="녹화 키는 켜고 끄는 토글입니다. 찍는 중에는 셋 중 아무 키나 눌러도 멈춥니다."/>

                <!-- ================= 녹화 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="녹화"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Label}" Text="형식" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbMp4" GroupName="recfmt" Content="MP4 (H.264)"/>
                    <RadioButton x:Name="RbGif" GroupName="recfmt" Content="움직이는 GIF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource Label}" Text="초당 장수" Margin="0,0,8,0"/>
                    <Slider x:Name="SlFps" Width="150" Minimum="1" Maximum="120"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <ed:NumberStepper x:Name="FpsBox" Width="116" Height="26" Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="숫자를 직접 쳐 넣어도 됩니다. 칸 위에서 휠을 굴려도 됩니다."/>
                    <Button x:Name="BtnFpsDefault" Style="{StaticResource ToolButton}" Content="기본값"
                            Margin="8,0,0,0" ToolTip="기본값(60 fps)으로 되돌립니다" Click="OnFpsDefault"/>
                </StackPanel>
                <TextBlock x:Name="LbFpsNote" Style="{StaticResource Note}" Margin="0,0,0,4"/>
                <CheckBox x:Name="CbRecAudio" Content="지금 나오는 소리도 같이 담기 (MP4 만)"/>
                <CheckBox x:Name="CbRecCursor" Content="마우스 커서 포함"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <TextBlock Style="{StaticResource Label}" Text="시작 전 세기" Margin="0,0,8,0"/>
                    <ed:NumberStepper x:Name="CountdownBox" Width="104" Height="26" VerticalAlignment="Center"
                                      ToolTip="0 이면 바로 시작합니다. 세는 동안 녹화 키를 다시 누르면 취소됩니다."/>
                </StackPanel>
                <CheckBox x:Name="CbRecSound" Content="시작음·종료음 내기" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="소리 크기" Margin="0,0,8,0"/>
                    <Slider x:Name="SlRecVolume" Width="150" Minimum="0" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="OnRecVolumeChanged"/>
                    <TextBlock x:Name="LbRecVolume" Style="{StaticResource Label}" Margin="8,0,8,0" MinWidth="34"/>
                    <Button Style="{StaticResource ToolButton}" Content="들어보기" Click="OnPreviewRecordSound"/>
                </StackPanel>
                <Grid Margin="0,6,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="이름 규칙"/>
                    <TextBox x:Name="TbRecPattern" Grid.Column="1"/>
                </Grid>
                <TextBlock x:Name="TbRecPreview" Style="{StaticResource Note}" Margin="86,2,0,6"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="녹화 중에는 찍고 있는 영역이 빨간 점선으로 깜빡이고, 구석의 막대로 잠깐 쉬거나 멈출 수 있습니다. 막대와 테두리는 영상에 찍히지 않습니다. 시작음은 다 난 뒤에 녹음이 시작되어 영상에 안 들어갑니다. MP4 를 못 만드는 환경에서는 GIF 로 넘어가고, 그때는 소리가 안 담깁니다."/>

                <!-- ================= 뷰어 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="뷰어"/>
                <TextBlock Style="{StaticResource Label}" Text="이미지를 열었을 때 기본 배율" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RbShrink" GroupName="fit" Content="창보다 클 때만 축소"/>
                    <RadioButton x:Name="RbStretch" GroupName="fit" Content="항상 창에 맞춤"/>
                    <RadioButton x:Name="RbFitWidth" GroupName="fit" Content="폭에 맞춤"/>
                    <RadioButton x:Name="RbActual" GroupName="fit" Content="100%"/>
                </StackPanel>
                <CheckBox x:Name="CbChecker" Content="투명한 부분에 체커보드 깔기"/>
                <CheckBox x:Name="CbWrap" Content="마지막 이미지에서 다음을 누르면 처음으로"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="이 배율부터 픽셀 또렷하게" Margin="0,0,8,0"/>
                    <Slider x:Name="SlNearest" Width="150" Minimum="1" Maximum="10"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LbNearest" Style="{StaticResource Label}" Margin="8,0,0,0" MinWidth="46"/>
                </StackPanel>

                <CheckBox x:Name="CbStrip" Content="뷰어 아래에 폴더의 모든 이미지를 썸네일로 보기"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="뷰어에서 G 키로도 켜고 끌 수 있습니다. 마우스 휠은 확대·축소 전용입니다."/>

                <!-- ================= 재생 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="영상 재생"/>
                <CheckBox x:Name="CbLoop" Content="끝나면 처음부터 다시 (반복)"/>
                <CheckBox x:Name="CbNextInFolder" Content="반복이 꺼져 있으면 폴더의 다음 영상으로 이어 재생"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="같은 폴더의 영상만 이어서 봅니다. 사진은 건너뜁니다. 마지막 영상 다음은 위 '마지막에서 처음으로' 설정을 따릅니다."/>
                <CheckBox x:Name="CbWheelVolume" Content="재생 중 마우스 휠로 소리 크기 조절"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="그림을 볼 때는 휠이 확대·축소 그대로입니다. 방향키 위아래도 계속 소리 크기입니다."/>
                <CheckBox x:Name="CbNewWindow" Content="영상을 열 때 재생 창을 새로 띄우기"/>
                <TextBlock Style="{StaticResource Note}"
                           Text="끄면 이미 열려 있는 재생 창에 갈아 끼웁니다. 켜면 영상 두 개를 나란히 놓고 볼 수 있습니다. 사진은 이 설정과 상관없이 언제나 보던 창에 갈아 끼웁니다 — 폴더를 훑을 때마다 창이 쌓이면 못 쓰니까요."/>
                <TextBlock Style="{StaticResource Note}"
                           Text="그림 뷰어와 영상 재생 창은 따로 뜹니다. 사진을 보다가 영상을 열어도 보던 사진이 사라지지 않고, 그 반대도 마찬가지입니다."/>
                <StackPanel Orientation="Horizontal" Margin="22,4,0,4">
                    <TextBlock Style="{StaticResource Label}" Text="방향키로 건너뛸 시간" Margin="0,0,8,0"/>
                    <ed:NumberStepper x:Name="SkipBox" Width="104" Height="26" VerticalAlignment="Center"
                                      ToolTip="숫자를 직접 쳐 넣어도 됩니다. 0.1 ~ 600초."/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="한 장씩 옮기는 키는 이 값과 상관없이 언제나 정확히 한 장입니다(MP4 계열에서만 됩니다)."/>

                <TextBlock Style="{StaticResource Label}" Text="재생 중에 쓰는 키" Margin="0,10,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="재생 / 멈춤"/>
                    <p:HotKeyBox x:Name="PkPlayPause" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Label}" Text="소리 크게"/>
                    <p:HotKeyBox x:Name="PkVolumeUp" Grid.Row="0" Grid.Column="4" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="뒤로"/>
                    <p:HotKeyBox x:Name="PkBack" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Label}" Text="소리 작게"/>
                    <p:HotKeyBox x:Name="PkVolumeDown" Grid.Row="1" Grid.Column="4" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="앞으로"/>
                    <p:HotKeyBox x:Name="PkForward" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Label}" Text="소리 끄기"/>
                    <p:HotKeyBox x:Name="PkMute" Grid.Row="2" Grid.Column="4" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="한 장 뒤로"/>
                    <p:HotKeyBox x:Name="PkPrevFrame" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Label}" Text="반복"/>
                    <p:HotKeyBox x:Name="PkLoop" Grid.Row="3" Grid.Column="4" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="한 장 앞으로"/>
                    <p:HotKeyBox x:Name="PkNextFrame" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Label}" Text="이 장면 저장"/>
                    <p:HotKeyBox x:Name="PkGrabFrame" Grid.Row="4" Grid.Column="4" Margin="0,3"/>
                </Grid>
                <TextBlock x:Name="PlayerKeyNote" Style="{StaticResource Note}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                           Text="뷰어 창이 앞에 있을 때만 듣는 키입니다(전역 단축키가 아닙니다). 칸을 비워 두면 그 기능은 단추로만 씁니다. 파일 이동은 재생 중에도 PageUp · PageDown 입니다."/>

                <!-- ================= 일반 ================= -->
                <TextBlock Style="{StaticResource Section}" Text="일반"/>
                <CheckBox x:Name="CbStartup" Content="윈도우 시작할 때 자동 실행"/>

                <TextBlock Style="{StaticResource Label}" Text="이 PC 에 남는 것" Margin="0,12,0,4"/>
                <TextBlock x:Name="LbStored" Style="{StaticResource Note}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="BtnClearData" Style="{StaticResource ToolButton}"
                            Content="기록 지우기" Click="OnClearData"/>
                    <TextBlock x:Name="LbClearNote" Style="{StaticResource Note}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}"
                           Text="그림이나 영상을 따로 캐시해 두지는 않습니다 — 썸네일은 보일 때 읽고 창을 닫으면 사라집니다. 디스크에 남는 것은 설정과 기록뿐이고, 기록에는 열어 본 파일의 경로가 들어갑니다."/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="기본 이미지 · 영상 앱으로 연결..."
                            Click="OnAssociate"/>
                    <TextBlock x:Name="AssocNote" Style="{StaticResource Note}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                           x:Name="AssocFormats"/>

                <!-- ================= 만든 곳 ================= -->
                <Border Margin="0,26,0,4" Padding="14,12" CornerRadius="8"
                        Background="{StaticResource BgChrome}"
                        BorderBrush="{StaticResource Divider}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="9to6blog" Foreground="{StaticResource Fg}"
                                   FontSize="15" FontWeight="Bold"/>
                        <TextBlock Margin="0,4,0,0">
                            <Hyperlink NavigateUri="https://9to6blog.com"
                                       RequestNavigate="OnBrandLink"
                                       Foreground="{StaticResource Accent}"
                                       TextDecorations="None">
                                <Run Text="https://9to6blog.com" FontSize="12.5"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
