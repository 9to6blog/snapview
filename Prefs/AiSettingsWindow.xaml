<Window x:Class="SnapView.Prefs.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 이미지 처리 설정 — SnapView" Width="660" Height="685" MinWidth="550" MinHeight="510"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Accent}" MinHeight="24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Style="{StaticResource ToolButton}" IsCancel="True"/>
                <Button Content="설정 저장" Style="{StaticResource ToolButton}" Click="OnSave" Foreground="#FF8CD9A9"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="내 키로 직접 연결" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="키는 이 PC의 Windows 사용자 계정으로 암호화해 보관합니다. SnapView 서버를 거치지 않고 선택한 제공사에 직접 연결합니다."
                           TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Margin="0,0,0,20"/>
                <TextBlock Text="제공사" Margin="0,0,0,6"/>
                <ComboBox x:Name="ProviderBox" Height="32" SelectionChanged="OnProviderChanged"/>
                <TextBlock x:Name="ProviderNote" TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Margin="0,8,0,16"/>
                <TextBlock Text="모델 ID" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModelBox" IsEditable="True" Height="32"/>
                <TextBlock Text="API 기본 주소" Margin="0,16,0,6"/>
                <TextBox x:Name="EndpointBox" Padding="8,6"/>
                <TextBlock Text="API 키" Margin="0,16,0,6"/>
                <PasswordBox x:Name="KeyBox" Padding="8,7" Background="{StaticResource BgChrome}" Foreground="{StaticResource Fg}"
                             BorderBrush="{StaticResource Divider}" BorderThickness="1" MaxLength="4096"/>
                <TextBlock x:Name="KeyState" TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Margin="0,6,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="저장한 키 삭제" Style="{StaticResource ToolButton}" Click="OnDeleteKey"/>
                    <Button Content="공식 API 문서 열기" Style="{StaticResource ToolButton}" Click="OnDocumentation"/>
                </StackPanel>
                <Border Background="{StaticResource BgChrome}" CornerRadius="6" Padding="13" Margin="0,18,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Text="이미지 처리 실행 시 키는 HTTPS 인증에, 이미지와 요청 내용은 처리에 사용됩니다. 제공사의 보관 정책과 이용 요금이 적용됩니다.&#10;&#10;키·요청 내용은 프로젝트 파일이나 복구 파일에 넣지 않습니다. Windows 계정을 바꾸거나 다른 PC로 옮긴 경우 키를 다시 입력해야 할 수 있습니다."/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
