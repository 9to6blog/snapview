<Application x:Class="SnapView.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== 색 ===== -->
            <SolidColorBrush x:Key="Bg"        Color="#FF1B1B1F"/>
            <SolidColorBrush x:Key="BgChrome"  Color="#FF26262B"/>
            <SolidColorBrush x:Key="BgHover"   Color="#FF33333A"/>
            <SolidColorBrush x:Key="BgActive"  Color="#FF3E3E47"/>
            <SolidColorBrush x:Key="Divider"   Color="#FF3A3A42"/>
            <SolidColorBrush x:Key="Fg"        Color="#FFE9E9EC"/>
            <SolidColorBrush x:Key="FgDim"     Color="#FF9A9AA4"/>
            <SolidColorBrush x:Key="Accent"    Color="#FF4DA3FF"/>

            <!-- 투명 이미지 뒤에 깔리는 체커보드 -->
            <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,16,16"
                          ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF2C2C31">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,16,16"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF232327">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,8,8"/>
                                    <RectangleGeometry Rect="8,8,8,8"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- ===== 툴바 버튼 ===== -->
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgActive}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 도구 선택 토글 ===== -->
            <Style x:Key="ToolToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="#FF10131A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 색 견본 ===== -->
            <Style x:Key="Swatch" TargetType="RadioButton">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                                <Ellipse Margin="3" Fill="{TemplateBinding Background}"
                                         Stroke="#40FFFFFF" StrokeThickness="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Fg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FgDim}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="6,7"/>
                <Setter Property="Fill" Value="{StaticResource Divider}"/>
            </Style>

            <!-- 리본 한 묶음의 제목. 아래에 도구들이 놓인다. -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <!-- ===================================================== 아이콘
                 특수문자(▾ ＋ 🎨)는 글꼴마다 모양·크기가 제멋대로다.
                 필요한 것만 직접 그린다 — 어느 PC 에서나 같게 보인다. -->
            <Geometry x:Key="IconChevron">M 0,0 L 4.5,4.5 L 9,0</Geometry>
            <Geometry x:Key="IconPlus">M 0,5 L 10,5 M 5,0 L 5,10</Geometry>
            <Geometry x:Key="IconMinus">M 0,5 L 10,5</Geometry>
            <Geometry x:Key="IconCheck">M 0,4.5 L 3.6,8 L 10,0.6</Geometry>
            <Geometry x:Key="IconClose">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>

            <!-- 앞뒤 이동 -->
            <Geometry x:Key="IconArrowLeft">M 6,0 L 1,5 L 6,10</Geometry>
            <Geometry x:Key="IconArrowRight">M 1,0 L 6,5 L 1,10</Geometry>

            <!-- 돌리기.
                 가운데 (7,7.5) 반지름 5 짜리 원을 위쪽만 남기고 그린 뒤, 그 트인 자리에
                 화살촉을 붙인다. 화살촉이 원에 붙어 있으면 작게 줄였을 때 그냥 동그라미로
                 보인다 — 원을 넉넉히 트고 촉을 원 밖으로 조금 내민다. -->
            <Geometry x:Key="IconRotateRight">M 9.5,3.2 A 5,5 0 1 1 4.5,3.2 M 6.9,4.1 L 10.6,3.5 L 8.8,0.4</Geometry>
            <Geometry x:Key="IconRotateLeft">M 4.5,3.2 A 5,5 0 1 0 9.5,3.2 M 7.1,4.1 L 3.4,3.5 L 5.2,0.4</Geometry>

            <!-- 뒤집기. 축 하나와 바깥을 향한 화살촉 둘.
                 촉이 작으면 축과 뭉쳐서 마름모로 보이므로 폭을 끝까지 쓴다. -->
            <Geometry x:Key="IconFlipH">M 7,0 L 7,14 M 4.6,2.6 L 0.6,7 L 4.6,11.4 M 9.4,2.6 L 13.4,7 L 9.4,11.4</Geometry>
            <Geometry x:Key="IconFlipV">M 0,7 L 14,7 M 2.6,4.6 L 7,0.6 L 11.4,4.6 M 2.6,9.4 L 7,13.4 L 11.4,9.4</Geometry>

            <!-- 창 -->
            <Geometry x:Key="IconFullScreen">M 0.5,3.5 V 0.5 H 3.5 M 8.5,0.5 H 11.5 V 3.5 M 11.5,8.5 V 11.5 H 8.5 M 3.5,11.5 H 0.5 V 8.5</Geometry>

            <!-- 재생. 삼각형·막대는 선이 아니라 면이라 IconSolid 로 칠한다. -->
            <Geometry x:Key="IconPlay">M 1,0.5 L 10,6 L 1,11.5 Z</Geometry>
            <Geometry x:Key="IconPause">M 1,0.5 H 4 V 11.5 H 1 Z M 7,0.5 H 10 V 11.5 H 7 Z</Geometry>
            <Geometry x:Key="IconSkipBack">M 5.5,1 L 0.5,6 L 5.5,11 Z M 11.5,1 L 6.5,6 L 11.5,11 Z</Geometry>
            <Geometry x:Key="IconSkipForward">M 6.5,1 L 11.5,6 L 6.5,11 Z M 0.5,1 L 5.5,6 L 0.5,11 Z</Geometry>
            <Geometry x:Key="IconStepBack">M 9,1 L 4,6 L 9,11 Z M 1,1 H 3 V 11 H 1 Z</Geometry>
            <Geometry x:Key="IconStepForward">M 3,1 L 8,6 L 3,11 Z M 9,1 H 11 V 11 H 9 Z</Geometry>

            <!-- 소리 · 반복 · 장면 저장 -->
            <Geometry x:Key="IconVolume">M 0.5,4 L 3,4 L 6.5,1 L 6.5,11 L 3,8 L 0.5,8 Z M 8.5,3.8 A 3,3 0 0 1 8.5,8.2</Geometry>
            <Geometry x:Key="IconMute">M 0.5,4 L 3,4 L 6.5,1 L 6.5,11 L 3,8 L 0.5,8 Z M 8.6,4.2 L 11.8,7.8 M 11.8,4.2 L 8.6,7.8</Geometry>
            <Geometry x:Key="IconLoop">M 1.5,4.5 V 4 A 2.5,2.5 0 0 1 4,1.5 H 10.5 M 8.6,0 L 10.8,1.5 L 8.6,3 M 10.5,7.5 V 8 A 2.5,2.5 0 0 1 8,10.5 H 1.5 M 3.4,9 L 1.2,10.5 L 3.4,12</Geometry>
            <Geometry x:Key="IconCamera">M 0.5,3.2 H 3.2 L 4.4,1.2 H 7.6 L 8.8,3.2 H 11.5 V 10.8 H 0.5 Z M 6,4.8 A 2.2,2.2 0 1 1 5.98,4.8</Geometry>

            <Style x:Key="Icon" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource Fg}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="IconDim" TargetType="Path" BasedOn="{StaticResource Icon}">
                <Setter Property="Stroke" Value="{StaticResource FgDim}"/>
            </Style>

            <!-- 속을 채우는 아이콘(재생 삼각형 등). 선을 겹치면 모서리가 뭉뚝해진다. -->
            <Style x:Key="IconSolid" TargetType="Path">
                <Setter Property="Fill" Value="{StaticResource Fg}"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- ===================================================== 재생 위치 막대
                 기본 슬라이더는 손잡이(작은 네모)를 정확히 눌러서 끌어야 한다. 영상에서는
                 "저기쯤 보고 싶다" 가 대부분이라 그게 성가시다. 여기서는 막대 아무 데나
                 눌러도 그 자리로 가고, 누른 채 그대로 끌 수 있다(IsMoveToPointEnabled).

                 지나온 구간은 채워서 보여 준다. 따로 그리지 않고 트랙의 "지나온 쪽"
                 단추 자체를 칠한다 — 값에 맞춰 폭이 저절로 맞는다. -->
            <Style x:Key="SliderTrackPast" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <!-- 바깥 Border 는 누를 자리를 넓히려고 둔다(얇은 선만 누르기 어렵다) -->
                            <Border Background="Transparent">
                                <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                        Background="{StaticResource Accent}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderTrackAhead" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackPast}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent">
                                <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                        Background="{StaticResource BgActive}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaSliderThumb" TargetType="Thumb">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="14" Height="14" Background="Transparent">
                                <Ellipse x:Name="Dot" Width="12" Height="12"
                                         Fill="{StaticResource Fg}"
                                         Stroke="{StaticResource Accent}" StrokeThickness="1.5"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Width" Value="14"/>
                                    <Setter TargetName="Dot" Property="Height" Value="14"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaSlider" TargetType="Slider">
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="MinHeight" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" Height="20">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Style="{StaticResource SliderTrackPast}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Style="{StaticResource SliderTrackAhead}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MediaSliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 창 안의 모든 막대를 재생 막대와 같은 모양으로 쓴다.
                 기본 슬라이더는 손잡이가 작아서 짚기 어렵고 지나온 구간도 안 보인다. -->
            <Style TargetType="Slider" BasedOn="{StaticResource MediaSlider}"/>

            <!-- ===================================================== 콤보 상자
                 기본 콤보는 흰 바탕이라 어두운 창에서 혼자 튄다. -->
            <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgActive}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>

            <Style x:Key="DarkCombo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="{StaticResource Bg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome"
                                                    Background="{StaticResource Bg}"
                                                    BorderBrush="{StaticResource Divider}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"/>
                                                    <Path Grid.Column="1" Style="{StaticResource IconDim}"
                                                          Data="{StaticResource IconChevron}"
                                                          Margin="6,1,9,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background"
                                                            Value="{StaticResource BgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="Selection" IsHitTestVisible="False"
                                                  Margin="9,0,28,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       Placement="Bottom" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{StaticResource BgChrome}"
                                            BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                            CornerRadius="5" Margin="0,2,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer>
                                            <ItemsPresenter Margin="3"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkCombo}"/>

            <!-- ===================================================== 글자 입력칸
                 기본 TextBox 는 <b>못 쓰는 상태가 되면 밝은 회색</b>으로 칠해진다
                 (SystemColors.ControlBrush). 어두운 창에서 그 칸만 허옇게 뜬다.
                 여기서는 흐리게만 만든다. -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>

            <!-- 눌러 두면 계속 먹는 단추(＋ − 처럼). 기본 모양은 회색 상자라 안 쓴다. -->
            <Style x:Key="FlatRepeat" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgActive}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================================================== 목록 -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgActive}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================================================== 체크 상자 -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                        Background="{StaticResource Bg}"
                                        BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Tick" Style="{StaticResource Icon}"
                                          Data="{StaticResource IconCheck}" Width="10" Height="9"
                                          Stretch="Fill" Stroke="White" StrokeThickness="1.8"
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FgDim}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================================================== 라디오 -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="15" Height="15" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Fill="{StaticResource Bg}"
                                             Stroke="{StaticResource Divider}" StrokeThickness="1"/>
                                    <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource Accent}"
                                             Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FgDim}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================================================== 스크롤 막대
                 기본 막대는 밝은 회색이라 어두운 창에서 눈에 확 띈다.
                 화살표 단추 없이 손잡이만 둔다. -->
            <Style x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bar" Background="#FF4A4A55" CornerRadius="4" Margin="2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="#FF63636F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                                          Background="Transparent" BorderThickness="0"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                                          Background="Transparent" BorderThickness="0"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===================================================== 메뉴 -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource BgChrome}"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource BgChrome}"
                                    BorderBrush="{StaticResource Divider}" BorderThickness="1"
                                    CornerRadius="6" Padding="4">
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 메뉴 안의 구분선은 이 스타일을 안 쓴다. 메뉴는 MenuItem.SeparatorStyleKey 로
                 따로 찾아가기 때문에, 그쪽을 안 덮으면 기본 흰 줄이 그대로 나온다. -->
            <ControlTemplate x:Key="DividerLine" TargetType="Separator">
                <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="8,4"/>
            </ControlTemplate>

            <Style TargetType="Separator">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource Divider}"/>
                <Setter Property="Template" Value="{StaticResource DividerLine}"/>
            </Style>

            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource Divider}"/>
                <Setter Property="Template" Value="{StaticResource DividerLine}"/>
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,14,0"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
