    <Geometry x:Key="EditFront">M 4,14 L 12,6 L 20,14 M 12,6 V 23 M 3,1 H 21</Geometry>
    <Geometry x:Key="EditBack">M 4,10 L 12,18 L 20,10 M 12,18 V 1 M 3,23 H 21</Geometry>
    <Geometry x:Key="EditDelete">M 3,6 H 21 M 8,6 V 2 H 16 V 6 M 5,6 L 6,22 H 18 L 19,6 M 10,10 V 18 M 14,10 V 18</Geometry>
    <Geometry x:Key="EditHelp">M 12,2 A 10,10 0 1 1 11.99,2 M 8,8 C 8,3 17,4 16,9 C 16,11 12,11 12,15 M 12,18 V 18.5</Geometry>

    <Geometry x:Key="EditSaveAs">M 3,2 H 16 L 21,7 V 12 M 3,2 V 22 H 11 M 7,2 V 9 H 16 V 2 M 12,20 L 20,12 L 23,15 L 15,23 H 12 Z</Geometry>
    <Geometry x:Key="EditRuler">M 2,6 H 22 V 18 H 2 Z M 6,6 V 12 M 10,6 V 10 M 14,6 V 12 M 18,6 V 10</Geometry>
    <Geometry x:Key="EditClearGuides">M 7,2 V 22 M 2,7 H 22 M 14,14 L 22,22 M 22,14 L 14,22</Geometry>
    <Geometry x:Key="EditAlign">M 3,2 V 22 M 6,4 H 22 V 9 H 6 Z M 6,14 H 16 V 19 H 6 Z</Geometry>
    <DataTemplate x:Key="EditorMenuContent">
        <StackPanel Orientation="Horizontal">
            <Path Style="{DynamicResource EditorGlyph}" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            <Path Data="M 1,2 L 5,6 L 9,2" Width="8" Height="5" Stretch="Uniform" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type p:ButtonBase}}}" Margin="7,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="EditorGlyph" TargetType="Path">
        <Setter Property="Data" Value="{Binding Path=(ed:ToolbarIcon.Data), RelativeSource={RelativeSource AncestorType={x:Type p:ButtonBase}}}"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type p:ButtonBase}}}"/>
        <Setter Property="StrokeThickness" Value="1.55"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <DataTemplate x:Key="EditorIconAndText">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource EditorGlyph}" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="EditorIconOnly">
        <Path Style="{StaticResource EditorGlyph}"/>
    </DataTemplate>
    <DataTemplate x:Key="EditorToolContent">
        <StackPanel>
            <Path Style="{StaticResource EditorGlyph}" Width="16" Height="16" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="EditorAction" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EditorIconAndText}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BgHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource BgActive}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorIconButton" TargetType="Button" BasedOn="{StaticResource EditorAction}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EditorIconOnly}"/>
    </Style>
    <Style x:Key="EditorPrimaryAction" TargetType="Button" BasedOn="{StaticResource EditorAction}">
        <Setter Property="Background" Value="#FF316BAD"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="EditorTool" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="1,2"/>
        <Setter Property="Margin" Value="1,1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EditorToolContent}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF233F61"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF487EB5"/>
                            <Setter Property="Foreground" Value="#FFB8DCFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorToggleAction" TargetType="ToggleButton" BasedOn="{StaticResource EditorTool}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EditorIconAndText}"/>
    </Style>
    <Style x:Key="EditorGroupCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="5,5,0,3"/>
    </Style>
    <Style x:Key="EditorActionGroup" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,2,8,2"/>
    </Style>
</ResourceDictionary>
