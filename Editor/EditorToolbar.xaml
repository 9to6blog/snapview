    <Geometry x:Key="EditFilter">M 4,2 V 22 M 12,2 V 22 M 20,2 V 22 M 1,7 H 7 M 9,16 H 15 M 17,9 H 23</Geometry>
    <Geometry x:Key="EditLayers">M 12,2 L 23,8 L 12,14 L 1,8 Z M 2,13 L 12,19 L 22,13 M 2,18 L 12,24 L 22,18</Geometry>
    <Geometry x:Key="EditImage">M 2,3 H 22 V 21 H 2 Z M 3,17 L 9,11 L 14,16 L 17,13 L 22,18 M 16,6 A 2,2 0 1 1 15.99,6</Geometry>
