<Window x:Class="SnapView.Editor.AiImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 이미지 처리 — SnapView" Width="980" Height="760" MinWidth="650" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="AI로 이미지 편집" FontSize="21" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="연결 설정" Style="{StaticResource ToolButton}" Click="OnSettings"/>
            <ComboBox x:Name="ProviderBox" Height="32" SelectionChanged="OnProviderChanged"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock x:Name="Destination" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="ConnectionState" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDim}"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="전송할 이미지" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="SourceBox" MinWidth="150" Height="32" SelectionChanged="OnSourceChanged"/>
                </StackPanel>
                <Border Background="{StaticResource Checkerboard}" BorderBrush="{StaticResource Divider}" BorderThickness="1" Padding="8">
                    <Image x:Name="SourcePreview" Stretch="Uniform"/>
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="ResultLabel" Text="처리 결과" Height="32" Margin="0,0,0,8" VerticalAlignment="Center"/>
                <Border Background="{StaticResource Checkerboard}" BorderBrush="{StaticResource Divider}" BorderThickness="1" Padding="8">
                    <Grid>
                        <TextBlock x:Name="ResultPlaceholder" Text="결과를 확인한 뒤 새 레이어로 추가하세요" TextWrapping="Wrap" Background="{StaticResource BgChrome}" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ResultPreview" Stretch="Uniform"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="어떻게 바꿀까요?" Margin="0,0,0,6"/>
            <TextBox x:Name="PromptBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="9" MaxLength="16000"
                     ToolTip="예: 배경을 부드러운 파스텔 톤으로 바꾸고 글자와 구도는 유지해 주세요."/>
            <TextBlock Text="선택한 제공사로 이미지·요청 내용과 인증 키를 전송합니다. API 요금과 제공사 보관 정책이 적용됩니다."
                       TextWrapping="Wrap" Foreground="{StaticResource FgDim}" FontSize="11.5" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,10,0,10">
            <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" MinHeight="28" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelRequest" Content="요청 취소" Style="{StaticResource ToolButton}" Click="OnCancelRequest" Visibility="Collapsed"/>
            <Button Content="닫기" Style="{StaticResource ToolButton}" Click="OnClose"/>
            <Button x:Name="SendButton" Content="전송하여 처리" Style="{StaticResource ToolButton}" Click="OnSend"/>
            <Button x:Name="ApplyButton" Content="새 레이어로 추가" Foreground="#FF8CD9A9" Style="{StaticResource ToolButton}" Click="OnApply" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
