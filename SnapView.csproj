<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SnapView</AssemblyName>
    <RootNamespace>SnapView</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>SnapView</Product>
    <Company>9to6blog</Company>
    <AssemblyTitle>SnapView — 캡처 &amp; 이미지 뷰어</AssemblyTitle>
    <LangVersion>latest</LangVersion>
    <!-- D3D11 vtable 직접 호출(Native/D3D11Interop.cs) 때문에 필요 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 화면 캡처·인코딩 네이티브가 x64 전용이다 -->
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <!-- WPF 앱이라 DPI 인식은 매니페스트로 선언해야 한다. WinForms 쪽 권고(WFAC010)는 해당 없음. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests / tools / installer 는 별도 프로젝트다. 본체 빌드에서 제외한다. -->
    <Compile Remove="tests\**;tools\**;installer\**" />
    <Page Remove="tests\**;tools\**;installer\**" />
    <None Remove="tests\**;tools\**;installer\**" />
  </ItemGroup>

</Project>
