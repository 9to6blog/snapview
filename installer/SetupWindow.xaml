<Window x:Class="SnapViewSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapView 설치"
        Width="560" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1F"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#FFE9E9EC"/>
        <SolidColorBrush x:Key="FgDim" Color="#FF9A9AA4"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4DA3FF"/>
        <SolidColorBrush x:Key="Divider" Color="#FF3A3A42"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF15151A"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#FF2A2A31"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="C" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="C" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="C" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="#FF2D7FF9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="26,7"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 머리말 -->
        <Border DockPanel.Dock="Top" Background="#FF23232A" Padding="22,18"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="48" Height="48" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SnapView" Foreground="{StaticResource Fg}"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="SubTitle" Foreground="{StaticResource FgDim}" FontSize="12"
                               Text="화면 캡처 · 주석 편집 · 이미지 뷰어"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 아래 버튼 -->
        <Border DockPanel.Dock="Bottom" Background="#FF23232A" Padding="20,12"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://9to6blog.com" RequestNavigate="OnBrandLink"
                               Foreground="{StaticResource Accent}" TextDecorations="None">
                        <Run Text="9to6blog  9to6blog.com" FontSize="12"/>
                    </Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource Flat}" Content="닫기" Click="OnCancel"/>
                    <Button x:Name="BtnGo" Style="{StaticResource Primary}" Content="설치" Click="OnGo"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 -->
        <Grid Margin="22,18">
            <StackPanel x:Name="FormPanel">
                <TextBlock Text="설치 위치" Foreground="{StaticResource Fg}" FontSize="12.5"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TbPath" Grid.Column="0"/>
                    <Button Grid.Column="1" Style="{StaticResource Flat}" Content="찾아보기"
                            Click="OnBrowse"/>
                </Grid>
                <TextBlock x:Name="PathNote" Foreground="{StaticResource FgDim}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="관리자 권한이 필요 없는 위치입니다. 제거할 때 이 폴더를 통째로 지웁니다."/>

                <TextBlock Text="설치 후" Foreground="{StaticResource Fg}" FontSize="12.5"
                           Margin="0,20,0,2"/>
                <CheckBox x:Name="CbDesktop" Content="바탕화면에 바로가기 만들기" IsChecked="True"/>
                <CheckBox x:Name="CbStartMenu" Content="시작 메뉴에 추가" IsChecked="True"/>
                <CheckBox x:Name="CbAssoc" Content="이미지 · 동영상 파일 연결 프로그램으로 등록" IsChecked="True"
                          ToolTip="png jpg gif webp … 와 mp4 mkv avi mov … 를 SnapView 로 열 수 있게 목록에 올립니다."/>
                <CheckBox x:Name="CbStartup" Content="윈도우 시작할 때 자동 실행"/>
                <CheckBox x:Name="CbLaunch" Content="설치가 끝나면 실행" IsChecked="True"/>

                <Border x:Name="ExistingBox" Visibility="Collapsed" Margin="0,20,0,0"
                        Background="#FF2A2118" BorderBrush="#FF6B5628" BorderThickness="1"
                        CornerRadius="6" Padding="12,10">
                    <TextBlock x:Name="ExistingText" Foreground="#FFE8D9A8" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- 진행/완료 화면 -->
            <StackPanel x:Name="StatusPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Foreground="{StaticResource Fg}" FontSize="16"
                           FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="StatusDetail" Foreground="{StaticResource FgDim}" FontSize="12.5"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>
