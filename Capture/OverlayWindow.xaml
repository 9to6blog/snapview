<Window x:Class="SnapView.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapView 영역 선택"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#FF101014"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True"
        Cursor="Cross">

    <Window.Resources>
        <Style x:Key="CapturePin" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFD8D8DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="ToolTip" Value="핀 켜기: 드래그 경계 자동 맞춤 · 끄면 다음 캡처에도 유지 (P)"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M 7,2 L 17,2 M 9,2 L 9,9 L 5,13 L 5,15 L 19,15 L 19,13 L 15,9 L 15,2 M 12,15 L 12,22"/>
                                <TextBlock Text="경계 맞춤" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StateLabel" Text="끔" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FF20466C"/>
                                <Setter Property="Foreground" Value="#FF91C9FF"/>
                                <Setter TargetName="StateLabel" Property="Text" Value="켬"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF354657"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- 얼려 둔 화면. Stretch=Fill 이라 DPI 가 섞인 멀티모니터에서도 1:1 로 대응된다.
             비트맵 픽셀이 물리 픽셀에 1:1 로 놓이므로 보간 품질은 결과에 차이가 없고,
             HighQuality(Fant) 는 저사양에서 마우스를 따라 다시 그릴 때마다 화면 전체를
             느리게 만든다 → NearestNeighbor. -->
        <Image x:Name="Backdrop" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- 선택 영역만 원본 밝기로 보여 주는 창.
             예전에는 밝은 배경 위에 구멍 뚫린 반투명 덮개를 얹었는데, 그러면 드래그로
             구멍이 움직일 때마다 덮개(=화면 전체)를 다시 그린다. 지금은 배경 자체를
             어둡게 구워 두고(코드에서 Darken) 선택 영역만 원본을 덧그린다 — 다시
             그리는 범위가 화면 전체에서 선택 영역만큼으로 준다. 아주 느린 PC 대비. -->
        <Canvas x:Name="HoleLayer" IsHitTestVisible="False">
            <Rectangle x:Name="Hole" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Canvas>

        <!-- 마우스를 받지 않는 순수 시각 요소들 -->
        <Canvas x:Name="Layer" IsHitTestVisible="False">

            <!-- 커서를 따라다니는 십자 안내선.
                 어두운 실선 위에 밝은 점선을 겹쳐 그려서, 배경이 밝든 어둡든 보이게 한다. -->
            <Line x:Name="CrossHBase" Stroke="#96000000" StrokeThickness="1" Visibility="Collapsed"/>
            <Line x:Name="CrossVBase" Stroke="#96000000" StrokeThickness="1" Visibility="Collapsed"/>
            <Line x:Name="CrossH" Stroke="#E6FFFFFF" StrokeThickness="1" Visibility="Collapsed"
                  StrokeDashArray="4 4"/>
            <Line x:Name="CrossV" Stroke="#E6FFFFFF" StrokeThickness="1" Visibility="Collapsed"
                  StrokeDashArray="4 4"/>

            <Rectangle x:Name="SelBorder" Stroke="#FF4DA3FF" StrokeThickness="1"
                       Visibility="Collapsed"/>

            <Border x:Name="SizeTip" Visibility="Collapsed"
                    Background="#F0202027" BorderBrush="#FF4DA3FF" BorderThickness="1"
                    CornerRadius="4" Padding="7,3">
                <TextBlock x:Name="SizeText" Foreground="#FFE9E9EC"
                           FontFamily="Consolas, Segoe UI" FontSize="12"/>
            </Border>

            <!-- 픽셀 돋보기 -->
            <Border x:Name="Loupe" Visibility="Collapsed" Width="140"
                    Background="#F0202027" BorderBrush="#FF3A3A42" BorderThickness="1"
                    CornerRadius="6" Padding="5">
                <StackPanel>
                    <Border Width="128" Height="128" ClipToBounds="True"
                            BorderBrush="#FF3A3A42" BorderThickness="1">
                        <Grid>
                            <Image x:Name="LoupeImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Rectangle Width="12" Height="12" Stroke="#FF4DA3FF" StrokeThickness="1.2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                        <Rectangle x:Name="LoupeSwatch" Width="12" Height="12" RadiusX="2" RadiusY="2"
                                   Stroke="#FF55555F" StrokeThickness="1" Fill="#FF000000"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LoupeText" Margin="6,0,0,0" Foreground="#FFCFCFD6"
                                   FontFamily="Consolas, Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 안내 -->
            <Border x:Name="HintBar" Visibility="Collapsed"
                    Background="#E6202027" BorderBrush="#FF3A3A42" BorderThickness="1"
                    CornerRadius="18" Padding="16,8">
                <TextBlock x:Name="HintText" Foreground="#FFD8D8DE" FontSize="12.5"/>
            </Border>

        </Canvas>

        <!-- 마우스를 받는 UI (액션 바) -->
        <Canvas x:Name="UiLayer" Background="Transparent" IsHitTestVisible="True">
            <Border x:Name="SnapOptions" Background="#F5202027" BorderBrush="#FF3A3A42" BorderThickness="1" CornerRadius="6" Padding="3">
                <ToggleButton x:Name="PinBeforeSelection" Style="{StaticResource CapturePin}" Click="OnSnapPin"/>
            </Border>
            <Border x:Name="ActionBar" Visibility="Collapsed" Cursor="Arrow"
                    Background="#F5202027" BorderBrush="#FF3A3A42" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnEdit" Style="{StaticResource ToolButton}" Content="편집"
                            ToolTip="찍어서 주석 편집기로 보낸다. 저장·복사는 편집을 마친 뒤에 한다 (E)" Click="OnActionEdit"/>
                    <Button x:Name="BtnCopy" Style="{StaticResource ToolButton}" Content="복사"
                            ToolTip="클립보드에만 넣는다. 파일로는 저장하지 않는다 (C)" Click="OnActionCopy"/>
                    <Button x:Name="BtnSave" Style="{StaticResource ToolButton}" Content="저장"
                            ToolTip="파일로만 저장한다. 클립보드에는 안 넣는다 (S · Space)" Click="OnActionSave"/>
                    <ToggleButton x:Name="PinAfterSelection" Style="{StaticResource CapturePin}" Click="OnSnapPin"/>
                    <Button x:Name="BtnMagnet" Style="{StaticResource ToolButton}" Content="영역 맞춤"
                            ToolTip="현재 선택을 한 번만 콘텐츠 경계에 맞춘다 · 핀 상태와 별개 (M)"
                            Click="OnAutoFitSelection"/>
                    <Rectangle x:Name="ActionSeparator" Style="{StaticResource ToolSeparator}"/>
                    <Button x:Name="BtnOk" Style="{StaticResource ToolButton}"
                            ToolTip="설정대로 처리 (Enter · 더블클릭)" Click="OnActionConfirm">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ConfirmIcon" Style="{StaticResource Icon}"
                                  Data="{StaticResource IconCheck}"
                                  Stroke="#FF6FD08C" Width="12" Height="11" Stretch="Uniform"
                                  Margin="0,0,6,0"/>
                            <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FFE05050"
                                     Margin="0,0,7,0" VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="ConfirmLabel" Text="확인" Foreground="#FF6FD08C"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancel" Style="{StaticResource ToolButton}"
                            ToolTip="취소 (ESC)" Click="OnActionCancel">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"
                              Stroke="#FFE0736B" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

    </Grid>
</Window>
