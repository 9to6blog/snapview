<Window x:Class="SnapView.Viewer.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapView"
        Width="1100" Height="800"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True">

    <Window.Resources>
        <!-- 썸네일 한 칸 -->
        <Style x:Key="ThumbItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="4" Background="#FF141418"
                                BorderBrush="Transparent" BorderThickness="2" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FgDim}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#FF1E2A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ============ 툴바 ============ -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top"
                Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">

                <Button x:Name="BtnPrev" Style="{StaticResource ToolButton}"
                        ToolTip="이전 이미지 (←, PageUp)" Click="OnPrev">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowLeft}"
                              Width="6" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="이전"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNext" Style="{StaticResource ToolButton}"
                        ToolTip="다음 이미지 (→, PageDown, Space)" Click="OnNext">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="다음"/>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowRight}"
                              Width="6" Height="10" Stretch="Uniform" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolSeparator}"/>

                <Button Style="{StaticResource ToolButton}" ToolTip="축소 (-)" Click="OnZoomOut">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconMinus}"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnZoomLabel" Style="{StaticResource ToolButton}" Content="100%"
                        MinWidth="58" ToolTip="클릭하면 100% (0)" Click="OnActualSize"/>
                <Button Style="{StaticResource ToolButton}" ToolTip="확대 (+)" Click="OnZoomIn">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>

                <Rectangle Style="{StaticResource ToolSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Content="맞춤"
                        ToolTip="창에 맞춤 (F)" Click="OnFit"/>
                <Button Style="{StaticResource ToolButton}" Content="폭"
                        ToolTip="폭에 맞춤 (W)" Click="OnFitWidth"/>

                <Rectangle Style="{StaticResource ToolSeparator}"/>

                <Button x:Name="BtnRotateLeft" Style="{StaticResource ToolButton}"
                        ToolTip="왼쪽으로 회전 (Shift+R)" Click="OnRotateLeft">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRotateLeft}"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnRotateRight" Style="{StaticResource ToolButton}"
                        ToolTip="오른쪽으로 회전 (R)" Click="OnRotateRight">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRotateRight}"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnFlipH" Style="{StaticResource ToolButton}"
                        ToolTip="좌우 뒤집기 (H)" Click="OnFlipHorizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFlipH}"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <Button x:Name="BtnFlipV" Style="{StaticResource ToolButton}"
                        ToolTip="상하 뒤집기 (V)" Click="OnFlipVertical">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFlipV}"
                          Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <Rectangle Style="{StaticResource ToolSeparator}"/>

                <Button x:Name="BtnEdit" Style="{StaticResource ToolButton}" Content="편집"
                        ToolTip="주석 편집기로 열기 (E)" Click="OnEdit"/>
                <Button x:Name="BtnCopy" Style="{StaticResource ToolButton}" Content="복사"
                        ToolTip="클립보드로 복사 (Ctrl+C)" Click="OnCopy"/>
                <Button x:Name="BtnSave" Style="{StaticResource ToolButton}" Content="저장"
                        ToolTip="돌리거나 뒤집은 그대로 원래 파일에 덮어쓰기 (Ctrl+S)" Click="OnSave"/>
                <Button x:Name="BtnSaveAs" Style="{StaticResource ToolButton}" Content="다른 이름"
                        ToolTip="다른 이름으로 저장 (Ctrl+Shift+S)" Click="OnSaveAs"/>
                <Button Style="{StaticResource ToolButton}" Content="열기"
                        ToolTip="이미지 열기 (Ctrl+O)" Click="OnOpen"/>
                <Button x:Name="BtnFolder" Style="{StaticResource ToolButton}" Content="폴더"
                        ToolTip="탐색기에서 보기 (Ctrl+E)" Click="OnRevealInExplorer"/>

                <Rectangle Style="{StaticResource ToolSeparator}"/>

                <ToggleButton x:Name="TbStrip" Style="{StaticResource ToolToggle}" Content="목록"
                              ToolTip="아래에 폴더의 모든 이미지 보기 (G)" Click="OnToggleStrip"/>
                <Button Style="{StaticResource ToolButton}"
                        ToolTip="전체 화면 (F11, 더블클릭)" Click="OnToggleFullScreen">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFullScreen}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="전체화면"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ============ 재생 막대 (움직이는 GIF · 동영상일 때만) ============ -->
        <Border x:Name="PlayBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <StackPanel>

            <!-- 편집 줄 (가위 토글로 열림): 구간 컷 · 배속 내보내기.
                 원본은 건드리지 않고 항상 저장 폴더에 새 MP4 로 나간다. -->
            <DockPanel x:Name="EditRow" Visibility="Collapsed" Margin="10,6,10,1">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMarkIn" Style="{StaticResource ToolButton}" Padding="8,4"
                            ToolTip="지금 위치를 구간 시작으로" Click="OnMarkIn">
                        <TextBlock Text="⟦ 시작"/>
                    </Button>
                    <Button x:Name="BtnMarkOut" Style="{StaticResource ToolButton}" Padding="8,4"
                            ToolTip="지금 위치를 구간 끝으로" Click="OnMarkOut">
                        <TextBlock Text="끝 ⟧"/>
                    </Button>
                    <TextBlock x:Name="EditRangeText" Style="{StaticResource StatusText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" Text="구간: 전체"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="배속" Style="{StaticResource FieldLabel}" Margin="12,0,5,0"/>
                    <ComboBox x:Name="EditSpeedBox" Width="72" Height="26" VerticalAlignment="Center"
                              ToolTip="내보낼 영상의 속도. 0.5×가 슬로우. 1×가 아니면 소리는 빠진다(음정이 틀어지므로)"/>
                    <Button x:Name="BtnExport" Style="{StaticResource ToolButton}" Margin="10,0,0,0"
                            Padding="10,4" Click="OnExportClip">
                        <TextBlock x:Name="ExportLabel" Text="MP4로 내보내기"/>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="EditStatus" Style="{StaticResource StatusText}"
                           Foreground="{StaticResource FgDim}" Margin="12,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <DockPanel Margin="10,5">

                <!-- 왼쪽: 재생 조작 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Style="{StaticResource ToolButton}" Padding="7,5"
                            Click="OnBack">
                        <Path Style="{StaticResource IconSolid}" Data="{StaticResource IconSkipBack}"
                              Width="13" Height="11"/>
                    </Button>
                    <Button x:Name="BtnPrevFrame" Style="{StaticResource ToolButton}" Padding="7,5"
                            Click="OnPrevFrame">
                        <Path Style="{StaticResource IconSolid}" Data="{StaticResource IconStepBack}"
                              Width="12" Height="11"/>
                    </Button>
                    <Button x:Name="BtnPlayPause" Style="{StaticResource ToolButton}"
                            MinWidth="44" Padding="7,5" Click="OnPlayPause">
                        <Path x:Name="PlayIcon" Style="{StaticResource IconSolid}"
                              Data="{StaticResource IconPause}" Width="11" Height="12"/>
                    </Button>
                    <Button x:Name="BtnNextFrame" Style="{StaticResource ToolButton}" Padding="7,5"
                            Click="OnNextFrame">
                        <Path Style="{StaticResource IconSolid}" Data="{StaticResource IconStepForward}"
                              Width="12" Height="11"/>
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource ToolButton}" Padding="7,5"
                            Click="OnForward">
                        <Path Style="{StaticResource IconSolid}" Data="{StaticResource IconSkipForward}"
                              Width="13" Height="11"/>
                    </Button>

                    <TextBlock x:Name="StPlayTime" Style="{StaticResource StatusText}"
                               Margin="10,0,4,0" MinWidth="96"/>
                    <TextBlock x:Name="StPlayFrame" Style="{StaticResource StatusText}"
                               Foreground="{StaticResource FgDim}" MinWidth="86"/>
                </StackPanel>

                <!-- 오른쪽: 장면 저장 · 소리 · 속도 · 반복 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnGrabFrame" Style="{StaticResource ToolButton}"
                            Margin="10,0,0,0" Click="OnGrabFrame">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCamera}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="이 장면"/>
                        </StackPanel>
                    </Button>

                    <ToggleButton x:Name="TbLoop" Style="{StaticResource ToolToggle}" Margin="8,0,0,0"
                                  Click="OnToggleLoop">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconLoop}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </ToggleButton>

                    <ToggleButton x:Name="TbEdit" Style="{StaticResource ToolToggle}" Margin="8,0,0,0"
                                  ToolTip="컷 · 배속 편집" Click="OnToggleEdit">
                        <TextBlock Text="편집"/>
                    </ToggleButton>

                    <TextBlock Text="속도" Style="{StaticResource FieldLabel}" Margin="12,0,5,0"/>
                    <ComboBox x:Name="SpeedBox" Width="72" Height="26" VerticalAlignment="Center"
                              ToolTip="재생 속도" SelectionChanged="OnSpeedChanged"/>

                    <Button x:Name="BtnMute" Style="{StaticResource ToolButton}"
                            Margin="10,0,0,0" Click="OnToggleMute">
                        <Path x:Name="MuteIcon" Style="{StaticResource Icon}"
                              Data="{StaticResource IconVolume}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="90" VerticalAlignment="Center"
                            Style="{StaticResource MediaSlider}"
                            Minimum="0" Maximum="1" Value="0.7"
                            ToolTip="소리 크기" ValueChanged="OnVolumeChanged"/>

                    <!-- 길어져도 가운데 위치 막대를 밀어내면 안 된다. 넘치면 잘라 낸다. -->
                    <TextBlock x:Name="StPlayNote" Style="{StaticResource StatusText}" Margin="12,0,0,0"
                               MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 가운데: 위치. 아무 데나 눌러도 그 자리로 간다. -->
                <Slider x:Name="PlaySlider" VerticalAlignment="Center" Margin="10,0"
                        Style="{StaticResource MediaSlider}"
                        Minimum="0" Maximum="1"
                        Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd"
                        ValueChanged="OnSeekChanged"/>
            </DockPanel>

            </StackPanel>
        </Border>

        <!-- ============ 상태 표시줄 ============ -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom"
                Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="12,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StFile" Style="{StaticResource StatusText}"
                               Foreground="{StaticResource Fg}" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StIndex" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StSize" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="StBytes" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <TextBlock x:Name="StZoom" Style="{StaticResource StatusText}"
                           HorizontalAlignment="Right" Margin="0"/>
            </Grid>
        </Border>

        <!-- ============ 아래 썸네일 줄 ============ -->
        <Border x:Name="StripPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <ListBox x:Name="Strip" Height="98" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ThumbItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnStripSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="104" Height="86" ToolTip="{Binding Name}">
                            <Image Source="{Binding Thumb}" Stretch="Uniform"
                                   Margin="0,0,0,14"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Loaded="OnThumbRealized"
                                   DataContextChanged="OnThumbContextChanged"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource FgDim}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ============ 이미지 무대 ============ -->
        <Grid x:Name="Stage" ClipToBounds="True" Background="{StaticResource Checkerboard}">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="주석 편집기로 열기" Click="OnEdit"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Canvas x:Name="Surface">
                <Image x:Name="Canvas1" Stretch="Fill"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Canvas>

            <!-- 동영상은 그림과 달리 픽셀을 못 만지므로 별도 층에서 재생한다.
                 MediaElement 가 아니라 MediaPlayer 를 직접 쓰고 여기에 칠한다 —
                 그래야 지금 화면을 그림 한 장으로 떠낼 수 있다(ViewerWindow.GrabFrame 참고). -->
            <Rectangle x:Name="Video" Visibility="Collapsed"/>

            <!-- 잠깐 떴다 사라지는 알림. 재생 막대에 글자를 밀어 넣으면 막대가 밀려나므로
                 배치에 끼지 않는 층에 띄운다(장면을 저장했을 때 쓴다). -->
            <Border x:Name="Toast" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,30" Padding="16,9" CornerRadius="18"
                    Background="#E6202027" BorderBrush="{StaticResource Divider}" BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Fg}" FontSize="12.5"
                           MaxWidth="620" TextTrimming="CharacterEllipsis"/>
            </Border>

            <TextBlock x:Name="EmptyHint"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource FgDim}" FontSize="14" TextAlignment="Center"
                       Text="이미지를 여기로 끌어다 놓으세요&#x0a;Ctrl+O 로 열 수도 있습니다"/>
        </Grid>

    </DockPanel>
</Window>
